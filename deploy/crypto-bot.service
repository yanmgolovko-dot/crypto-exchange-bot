[Unit]
Description=Crypto Exchange Telegram Bot
After=network.target

[Service]
Type=simple
User=botuser
Group=botuser
WorkingDirectory=/opt/crypto-bot
EnvironmentFile=/opt/crypto-bot/.env
ExecStart=/opt/crypto-bot/venv/bin/python -m bot.main
Restart=always
RestartSec=10

# Ограничения безопасности
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/crypto-bot/data /opt/crypto-bot/bot.log

# Логирование в journald
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target